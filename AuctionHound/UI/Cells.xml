<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Cells for the columns Hound adds to Blizzard's lists. The mixins
	     live in UI/Browse.lua and UI/Auctions.lua. -->

	<!-- Buy tab: a note on the left (the reference), a figure on the
	     right (the discount). -->
	<Frame name="AuctionHoundBrowseCellTemplate" mixin="AuctionHoundBrowseCellMixin" virtual="true">
		<Size x="0" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString parentKey="Text" inherits="Number14FontWhite" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Sub" inherits="GameFontDisableSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT"/>
						<Anchor point="RIGHT" relativeKey="$parent.Text" relativePoint="LEFT" x="-4" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- Auctions tab: buyout times units, left aligned like the price
	     cells beside it. -->
	<Frame name="AuctionHoundTotalCellTemplate" mixin="AuctionHoundTotalCellMixin" virtual="true">
		<Size x="0" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString parentKey="Text" inherits="Number14FontWhite" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT"/>
						<Anchor point="RIGHT"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
