<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- One cell of the Hound column on the Buy tab: a note on the left
	     (the reference), a figure on the right (the discount). The mixin
	     lives in UI/Browse.lua. -->
	<Frame name="AuctionHoundBrowseCellTemplate" mixin="AuctionHoundBrowseCellMixin" virtual="true">
		<Size x="0" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString parentKey="Text" inherits="Number14FontWhite" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Sub" inherits="GameFontDisableSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT"/>
						<Anchor point="RIGHT" relativeKey="$parent.Text" relativePoint="LEFT" x="-4" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
